# Create an OAuth app at https://github.com/settings/developers.
# Set its callback URL to the public URL where Gitstars will be served.
VITE_GITSTARS_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Host port exposed by Docker Compose.
GITSTARS_PORT=8080

# Directory containing localhost.pem and localhost-key.pem.
GITSTARS_CERT_DIR=./.certs

# UID/GID the Docker container runs as. The development private key is stored
# with mode 0600, so the container must run as the host user to read the
# read-only certificate mount. Set these to the output of `id -u` and `id -g`
# (the defaults used by compose.yaml are 1000:1000).
GITSTARS_UID=1000
GITSTARS_GID=1000

# Optional: backend base URL that `pnpm dev` proxies /api requests to.
# Only needed when testing the OAuth login flow locally, for example the URL
# of a deployed Gitstars instance.
VITE_API_PROXY=
